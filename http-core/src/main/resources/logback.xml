<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ====================================================================== -->
    <!-- VARIABLES DE CONFIGURACIÓN - API CORE                                 -->
    <!-- ====================================================================== -->
    <property name="LOG_HOME" value="./logs/api"/>
    <property name="MODULE_NAME" value="API"/>

    <!-- Pattern sin colores para archivos -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{module:-FRAMEWORK}][%X{testName:-NO_TEST}] %logger{36} - %msg%n"/>

    <!-- Pattern con colores para consola -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %magenta([%X{module:-FRAMEWORK}]) %cyan([%X{testName:-NO_TEST}]) %yellow(%logger{36}) - %msg%n"/>

    <!-- ====================================================================== -->
    <!-- FILTROS - SILENCIAR LOGS VERBOSOS                                     -->
    <!-- ====================================================================== -->

    <!-- Apache HttpClient - Silenciar logs binarios completamente -->
    <logger name="org.apache.hc.client5.http.wire" level="OFF" additivity="false"/>
    <logger name="org.apache.hc.client5.http.headers" level="OFF"/>
    <logger name="org.apache.hc.client5.http" level="WARN"/>
    <logger name="org.apache.http.wire" level="OFF" additivity="false"/>
    <logger name="org.apache.http.headers" level="OFF"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- SLF4J y Logback internos -->
    <logger name="org.slf4j" level="WARN" additivity="false"/>
    <logger name="ch.qos.logback" level="WARN" additivity="false"/>

    <!-- REST Assured -->
    <logger name="io.restassured" level="WARN"/>
    <logger name="io.restassured.filter" level="WARN"/>
    <logger name="io.restassured.internal" level="ERROR"/>

    <!-- Jackson JSON -->
    <logger name="com.fasterxml.jackson" level="WARN"/>

    <!-- ====================================================================== -->
    <!-- APPENDERS - SALIDAS DE LOGS                                           -->
    <!-- ====================================================================== -->

    <!-- Consola con filtro para solo mostrar logs del framework -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator>
                <expression>
                    logger.startsWith("com.qa") ||
                    level &gt;= WARN
                </expression>
            </evaluator>
            <OnMismatch>DENY</OnMismatch>
            <OnMatch>NEUTRAL</OnMatch>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo general para API -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/api-tests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/api-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo específico para requests/responses -->
    <appender name="API_REQUESTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/api-requests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/api-requests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>15</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [API-REQUEST] [%X{testName}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo de errores -->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/api-errors.log</file>
        <filter class="ch.qos.logback.core.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/api-errors.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>5MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ====================================================================== -->
    <!-- LOGGERS ESPECÍFICOS DEL MÓDULO API                                    -->
    <!-- ====================================================================== -->

    <logger name="com.qa.apicore" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR"/>
    </logger>

    <logger name="com.qa.common" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- ====================================================================== -->
    <!-- ROOT LOGGER                                                            -->
    <!-- ====================================================================== -->

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>

