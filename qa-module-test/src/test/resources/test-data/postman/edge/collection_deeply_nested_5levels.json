{
  "info": {
    "name": "Deeply Nested Collection — 5 Folder Levels",
    "description": "Collection with exactly 5 levels of folder nesting. Tests the maximum depth limit. Any requests at depth > 5 should either be rejected or flattened with a warning.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Level 1 — Region",
      "item": [
        {
          "name": "Level 2 — Country",
          "item": [
            {
              "name": "Level 3 — Service",
              "item": [
                {
                  "name": "Level 4 — Version",
                  "item": [
                    {
                      "name": "Level 5 — Resource (MAX DEPTH)",
                      "item": [
                        {
                          "name": "GET at max depth",
                          "request": {
                            "method": "GET",
                            "url": { "raw": "https://api.example.com/region/country/service/v1/resource", "host": ["api.example.com"], "path": ["region", "country", "service", "v1", "resource"] }
                          }
                        },
                        {
                          "name": "POST at max depth",
                          "request": {
                            "method": "POST",
                            "header": [{ "key": "Content-Type", "value": "application/json" }],
                            "url": { "raw": "https://api.example.com/region/country/service/v1/resource", "host": ["api.example.com"], "path": ["region", "country", "service", "v1", "resource"] },
                            "body": { "mode": "raw", "raw": "{\"data\": \"test\"}" }
                          }
                        },
                        {
                          "name": "Level 6 — SUB-RESOURCE (EXCEEDS MAX DEPTH)",
                          "item": [
                            {
                              "name": "GET at depth 6 — should be rejected or warned",
                              "request": {
                                "method": "GET",
                                "url": { "raw": "https://api.example.com/region/country/service/v1/resource/sub", "host": ["api.example.com"], "path": ["region", "country", "service", "v1", "resource", "sub"] }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Level 4 alternate — Another Version",
                  "item": [
                    {
                      "name": "Level 5 — Beta endpoint",
                      "item": [
                        {
                          "name": "GET beta resource",
                          "request": {
                            "method": "GET",
                            "url": { "raw": "https://api.example.com/region/country/service/v2/beta", "host": ["api.example.com"], "path": ["region", "country", "service", "v2", "beta"] }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "Level 2 — Direct request at top",
          "request": {
            "method": "GET",
            "url": { "raw": "https://api.example.com/region/info", "host": ["api.example.com"], "path": ["region", "info"] }
          }
        }
      ]
    }
  ]
}
