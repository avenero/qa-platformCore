{
  "info": {
    "name": "Legacy API — Postman v2.0 format",
    "description": "Collection using the older v2.0 schema. Tests that the parser accepts both v2.0 and v2.1 collections. Key difference: no 'variable' array at collection level in v2.0 and slightly different request URL format.",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://api.legacy.example.com/health"
      }
    },
    {
      "name": "Get Users",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "https://api.legacy.example.com/users"
      }
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"John Doe\", \"email\": \"john@example.com\"}"
        },
        "url": "https://api.legacy.example.com/users"
      }
    }
  ]
}
