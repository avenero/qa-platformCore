// ============================================================================
// Jenkinsfile Simple - Scotia QA Framework
// ============================================================================
//
// Pipeline básico para ejecutar tests de un módulo usando el framework.
// Copia este archivo a la raíz de tu módulo de testing.
//
// USO:
//   1. Copiar a: /path/to/qa-module-banking/Jenkinsfile
//   2. Configurar credenciales en Jenkins (ver README.md)
//   3. Crear Pipeline Job apuntando a tu repositorio
//
// @author Abel Venero
// @version 1.0.0
// ============================================================================

pipeline {
    agent any

    // ========================================================================
    // VARIABLES DE ENTORNO
    // ========================================================================
    environment {
        // Ambiente de testing
        TEST_ENV = 'qa'

        // Credenciales de Base de Datos (desde Jenkins Credentials)
        DB_URL = credentials('db-url-qa')
        DB_USER = credentials('db-user-qa')
        DB_PASS = credentials('db-pass-qa')

        // Credenciales de API (opcional, comentar si no se usa)
        // API_BASE_URL = 'https://api-qa.example.com'
        // API_TOKEN = credentials('api-token-qa')

        // Configuración de Web (opcional, comentar si no se usa)
        // WEB_BASE_URL = 'https://web-qa.example.com'
        // BROWSER = 'chrome'
        // HEADLESS = 'true'

        // Auto-detectado (no necesita configuración)
        // MODULE_NAME se detecta automáticamente desde el directorio
    }

    // ========================================================================
    // OPCIONES DEL PIPELINE
    // ========================================================================
    options {
        // Mantener solo los últimos 10 builds
        buildDiscarder(logRotator(numToKeepStr: '10'))

        // Timeout de 30 minutos
        timeout(time: 30, unit: 'MINUTES')

        // Timestamps en los logs
        timestamps()

        // Deshabilitar builds concurrentes
        disableConcurrentBuilds()
    }

    // ========================================================================
    // STAGES
    // ========================================================================
    stages {

        // ====================================================================
        // STAGE: Checkout
        // ====================================================================
        stage('Checkout') {
            steps {
                echo '📥 Descargando código fuente...'
                checkout scm
            }
        }

        // ====================================================================
        // STAGE: Verificar Dependencias
        // ====================================================================
        stage('Verificar Dependencias') {
            steps {
                echo '🔍 Verificando Java y Gradle...'
                sh '''
                    java -version
                    ./gradlew --version || gradle --version
                '''
            }
        }

        // ====================================================================
        // STAGE: Ejecutar Tests
        // ====================================================================
        stage('Ejecutar Tests') {
            steps {
                echo '🚀 Ejecutando tests...'
                sh '''
                    # Dar permisos de ejecución al script
                    chmod +x ../qa-scotia-frameworks/scripts/test.sh

                    # Ejecutar tests usando el framework
                    ../qa-scotia-frameworks/scripts/test.sh
                '''
            }
        }
    }

    // ========================================================================
    // POST ACTIONS
    // ========================================================================
    post {
        always {
            echo '📊 Publicando reportes...'

            // Publicar reportes de Cucumber (si existen)
            cucumber(
                buildStatus: 'UNSTABLE',
                fileIncludePattern: '**/cucumber-report.json',
                sortingMethod: 'ALPHABETICAL'
            )

            // Publicar reportes HTML de tests
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'build/reports/tests/test',
                reportFiles: 'index.html',
                reportName: 'Test Report'
            ])

            // Archivar resultados de tests
            junit(
                allowEmptyResults: true,
                testResults: '**/build/test-results/**/*.xml'
            )
        }

        success {
            echo '✅ Tests ejecutados exitosamente'

            // Descomentar para notificaciones
            // slackSend(
            //     color: 'good',
            //     message: "✅ Tests exitosos: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
            // )
        }

        failure {
            echo '❌ Tests fallaron'

            // Descomentar para notificaciones
            // slackSend(
            //     color: 'danger',
            //     message: "❌ Tests fallidos: ${env.JOB_NAME} #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
            // )
        }

        cleanup {
            echo '🧹 Limpiando workspace...'
            cleanWs()
        }
    }
}

