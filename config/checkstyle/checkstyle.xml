<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  CuAleon Test Engineering Platform — Checkstyle Configuration
  ============================================================
  Basado en Google Java Style Guide con adaptaciones para un framework QA:
    - Línea máxima: 120 chars (QA code es verboso por naturaleza)
    - Javadoc obligatorio en clases e interfaces públicas
    - Naming conventions estrictas
    - Sin imports wildcard
    - Sin variables no usadas
    - Control de complejidad ciclomática (máx. 15 por método)

  Este archivo aplica SOLO a fuentes principales (checkstyleTest está deshabilitado
  en el root build.gradle para evitar falsos positivos en código de tests).
-->
<module name="Checker">

    <!-- Charset -->
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- =========================================================
         Filtros: excluir archivos generados y clases de modelo
         ========================================================= -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module\-info\.java$"/>
    </module>

    <!-- =========================================================
         Checks a nivel de ARCHIVO
         ========================================================= -->

    <!-- Sin trailing whitespace -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Línea máxima 120 chars (relajado desde 100 para QA code) -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- =========================================================
         Checks a nivel de ÁRBOL (TreeWalker)
         ========================================================= -->
    <module name="TreeWalker">

        <!-- == Imports == -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>
        <module name="IllegalImport">
            <!-- Usar SLF4J, no Log4j directo ni java.util.logging -->
            <property name="illegalPkgs" value="sun, com.sun, java.util.logging"/>
        </module>

        <!-- == Naming Conventions == -->
        <module name="TypeName">
            <!-- Clases e interfaces: PascalCase -->
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <!-- Métodos: camelCase -->
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <!-- Constantes: UPPER_SNAKE_CASE -->
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-zA-Z_][a-zA-Z0-9_]*)*$"/>
        </module>

        <!-- == Javadoc == -->
        <module name="MissingJavadocType">
            <!-- Javadoc obligatorio en tipos públicos -->
            <property name="scope" value="public"/>
            <property name="skipAnnotations" value="Generated,Override"/>
        </module>
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/>
        </module>

        <!-- == Tamaño y complejidad == -->
        <module name="MethodLength">
            <!-- Máx. 80 líneas por método -->
            <property name="max" value="80"/>
        </module>
        <module name="CyclomaticComplexity">
            <!-- Máx. complejidad ciclomática 15 -->
            <property name="max" value="15"/>
        </module>
        <module name="ParameterNumber">
            <!-- Máx. 8 parámetros por método -->
            <property name="max" value="8"/>
        </module>

        <!-- == Buenas prácticas == -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
        </module>
        <module name="NeedBraces">
            <!-- Siempre llaves en if/for/while/do -->
            <property name="allowSingleLineStatement" value="false"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore|ignored"/>
        </module>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="FallThrough"/>

        <!-- == Magic Numbers (relajado para QA code) == -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2, 3, 4, 5, 10, 100, 200, 400, 404, 500"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <!-- == Modificadores == -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- == Espaciado == -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="ignoreEnhancedForColon" value="false"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, DOT"/>
        </module>
        <module name="GenericWhitespace"/>

        <!-- == Supresión local vía comentario == -->
        <module name="SuppressionCommentFilter">
            <!-- Permite //CHECKSTYLE:OFF ... //CHECKSTYLE:ON para bloques puntuales -->
        </module>

    </module>

</module>
