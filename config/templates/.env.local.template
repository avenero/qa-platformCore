# ============================================================
# VARIABLES DE ENTORNO - SCOTIA QA FRAMEWORK
# ============================================================
# Este archivo contiene variables sensibles para desarrollo local.
# ⚠️  NO COMMITEAR - Debe estar en .gitignore
# ============================================================
# Instrucciones:
# 1. Copiar este archivo a la raíz del módulo como .env.local
# 2. Completar los valores reales (eliminar placeholders)
# 3. Cargar antes de ejecutar tests: source .env.local (bash) o . .\.env.local (PowerShell)
# ============================================================

# ------------------------------------------------------------
# AMBIENTE
# ------------------------------------------------------------
TEST_ENV=QA
CI=false

# ------------------------------------------------------------
# ARTIFACTORY (Drivers)
# ------------------------------------------------------------
# URL base de Artifactory donde están alojados los drivers
ARTIFACTORY_BASE_URL=https://artifactory.scotia.com/artifactory/qa-drivers

# Credenciales de Artifactory (solicitar a equipo de Infra)
ARTIFACTORY_USER=tu_usuario_artifactory
ARTIFACTORY_TOKEN=tu_token_artifactory

# Versiones específicas de drivers a usar (opcional, sino usa latest)
CHROMEDRIVER_VERSION=114.0.5735.90
GECKODRIVER_VERSION=0.33.0
EDGEDRIVER_VERSION=114.0.1823.37

# ------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------
DB_URL=jdbc:oracle:thin:@//host:port/service
DB_USER=tu_usuario_bd
DB_PASS=tu_password_bd

# ------------------------------------------------------------
# JIRA / XRAY
# ------------------------------------------------------------
JIRA_USER=tu_usuario_jira
JIRA_PASSWORD=tu_password_jira
TEST_EXECUTION_ID=QAAUY-XXX

# ------------------------------------------------------------
# API TESTING
# ------------------------------------------------------------
API_BASE_URL=https://api-dev.your-app.com/v1
API_TOKEN=tu_token_api_dev

# ------------------------------------------------------------
# WEB TESTING
# ------------------------------------------------------------
WEB_BASE_URL=https://dev.your-app.com

# ------------------------------------------------------------
# MOBILE TESTING
# ------------------------------------------------------------
MOBILE_PLATFORM=android
MOBILE_DEVICE=emulator-5554
APP_PATH=/path/to/your/app.apk

# ------------------------------------------------------------
# WEBDRIVER (si usas driver local)
# ------------------------------------------------------------
WEBDRIVER_LOCAL_PATH=/path/to/chromedriver
SKIP_WDM=false

# ------------------------------------------------------------
# CI/CD (Jenkins/GitLab CI - normalmente las provee el servidor)
# ------------------------------------------------------------
BUILD_ID=local
BUILD_URL=

# ------------------------------------------------------------
# CUSTOM (específico del módulo)
# ------------------------------------------------------------
# Agregar aquí variables específicas de tu proyecto

