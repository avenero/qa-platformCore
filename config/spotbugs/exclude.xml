<?xml version="1.0" encoding="UTF-8"?>
<!--
  CuAleon Test Engineering Platform — SpotBugs Exclusion Filter
  ==============================================================
  Excluye falsos positivos conocidos en el contexto de un framework QA/BDD:

  • EI_EXPOSE_REP / EI_EXPOSE_REP2
      Los DTOs del framework (ExecutionResult, DeviceDescriptor, etc.) retornan
      referencias por diseño; no son APIs de biblioteca pública.

  • MS_MUTABLE_COLLECTION / MS_SHOULD_BE_FINAL
      Constantes de activación (Set<String>) en plugins son estáticas inmutables
      (Set.of). SpotBugs las marca de forma conservadora.

  • ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD
      ExecutionContext.activate() escribe en un ThreadLocal estático; este patrón
      es intencional y correcto en un contexto de ejecución BDD por-thread.

  • DM_EXIT
      CucumberRuntimeEngine llama a System.exit() en modo CLI; es comportamiento
      requerido por el contrato Cucumber.

  • RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE
      Falso positivo de SpotBugs 4.x con try-with-resources en Java 17+.

  • OBL_UNSATISFIED_OBLIGATION
      Los recursos Appium/Selenium se cierran vía shutdown hooks y quitDriverSafely();
      SpotBugs no puede trazar el cierre a través del ThreadLocal.

  • PATH_TRAVERSAL_IN, URLCONNECTION_SSRF_FD
      Las URLs de Appium/Selenium son configuradas por el QA engineer, no por
      input de usuario externo. No aplica hardening de SSRF aquí.
-->
<FindBugsFilter>

    <!-- =========================================================
         Modelo y DTOs — false positives de mutabilidad
         ========================================================= -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <Package name="~com\.qa\..*\.model.*"/>
            <Package name="~com\.qa\.common\.runtime.*"/>
        </Or>
    </Match>

    <!-- =========================================================
         Plugin activation tags — Set.of() es inmutable pero SpotBugs lo marca
         ========================================================= -->
    <Match>
        <Or>
            <Bug pattern="MS_MUTABLE_COLLECTION"/>
            <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT"/>
            <Bug pattern="MS_SHOULD_BE_FINAL"/>
        </Or>
        <Method name="getActivationTags"/>
    </Match>

    <!-- =========================================================
         ExecutionContext / DriverManager — ThreadLocal estático intencional
         ========================================================= -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Or>
            <Class name="~com\.qa\.common\.runtime\.ExecutionContext"/>
            <Class name="~com\.qa\.webcore\.driver\.DriverManager"/>
            <Class name="~com\.qa\.mobilecore\.driver\.MobileDriverManager"/>
        </Or>
    </Match>

    <!-- =========================================================
         CucumberRuntimeEngine — System.exit() intencional
         ========================================================= -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="~com\.qa\.common\.runtime\.CucumberRuntimeEngine"/>
    </Match>

    <!-- =========================================================
         Falso positivo: try-with-resources en Java 17+
         ========================================================= -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- =========================================================
         Appium / Selenium — recursos cerrados por shutdown hooks
         ========================================================= -->
    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
        <Or>
            <Package name="~com\.qa\.mobilecore.*"/>
            <Package name="~com\.qa\.webcore.*"/>
        </Or>
    </Match>

    <!-- =========================================================
         URLs de conexión — configuradas por el QA engineer, no input externo
         ========================================================= -->
    <Match>
        <Or>
            <Bug pattern="URLCONNECTION_SSRF_FD"/>
            <Bug pattern="PATH_TRAVERSAL_IN"/>
        </Or>
    </Match>

    <!-- =========================================================
         Exclusión global de clases generadas y excepciones simples
         ========================================================= -->
    <Match>
        <Or>
            <Package name="~.*\.exceptions.*"/>
            <Package name="~.*\.enums.*"/>
        </Or>
    </Match>

</FindBugsFilter>
