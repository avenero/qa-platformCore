<?xml version="1.0" encoding="UTF-8"?>
<!--
  mobile-agent — logback de tests minimalista. Sobreescribe el logback.xml que
  viaja en mobile-core/main/resources (que asume rolling-file con %i, no
  compatible con la validación estricta que hace Spring Boot al arrancar
  el ApplicationContext en @SpringBootTest).
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="com.qa" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
