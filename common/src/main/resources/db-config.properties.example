# Configuración de Base de Datos para Scotia QA Framework
# Este archivo debe ser copiado y personalizado según el entorno

# =================================================================================
# CONFIGURACIONES ORACLE
# =================================================================================
oracle.jdbc.url=jdbc:oracle:thin:@//10.34.36.43:1628/Banking
oracle.jdbc.user=AVENERO_PROXY
# oracle.jdbc.password=CONFIGURAR_EN_VARIABLES_DE_ENTORNO

# =================================================================================
# CONFIGURACIONES SQL SERVER
# =================================================================================
sqlserver.jdbc.url=jdbc:sqlserver://localhost:1433;databaseName=TestDB;encrypt=false
sqlserver.jdbc.user=sa
# sqlserver.jdbc.password=CONFIGURAR_EN_VARIABLES_DE_ENTORNO

# =================================================================================
# CONFIGURACIONES DEL POOL DE CONEXIONES
# =================================================================================
db.pool.max.size=10
db.pool.min.idle=2
db.pool.connection.timeout=30000
db.pool.idle.timeout=600000
db.pool.max.lifetime=1800000

# =================================================================================
# NOTAS IMPORTANTES:
# =================================================================================
# 1. Por seguridad, las contraseñas deben configurarse mediante variables de entorno:
#    - ORACLE_JDBC_PASSWORD
#    - SQLSERVER_JDBC_PASSWORD
#
# 2. Las configuraciones pueden sobrescribirse usando variables de entorno:
#    - ORACLE_JDBC_URL
#    - ORACLE_JDBC_USER
#    - SQLSERVER_JDBC_URL
#    - SQLSERVER_JDBC_USER
#    - DB_POOL_MAX_SIZE
#    - DB_POOL_MIN_IDLE
#    - DB_POOL_CONNECTION_TIMEOUT
#
# 3. También pueden sobrescribirse usando system properties (-D):
#    java -DORACLE_JDBC_URL=jdbc:oracle:thin:@//server:port/service ...
