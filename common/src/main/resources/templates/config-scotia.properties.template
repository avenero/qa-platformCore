# ====================================================================
# TEMPLATE DE CONFIGURACIÓN CONSOLIDADO - Framework Scotia QA
# ====================================================================
#
# Este template contiene TODAS las configuraciones posibles del framework.
# Incluye configuraciones para: WEB, API, MOBILE, DATABASE, REPORTING
#
# INSTRUCCIONES DE USO:
# 1. Copia este archivo a src/test/resources/ de tu módulo
# 2. Renombra según el ambiente:
#    - config-dev.properties
#    - config-qa.properties
#    - config-uat.properties
#    - config-prod.properties
# 3. Descomenta y configura SOLO las secciones que uses
# 4. Variables sensibles (passwords, tokens) van en .env.local
#
# ====================================================================

# ====================================================================
# MÓDULO (Para logging dinámico y organización)
# ====================================================================

# Nombre del módulo (aparece en logs)
# OBLIGATORIO - Ejemplo: BANKING, AUTOS, MOBILE_PAYMENTS
framework.module.name=YOUR_MODULE_NAME

# Tipo de módulo: WEB, API, MOBILE, HYBRID
# OPCIONAL - Ayuda a documentar el propósito del módulo
framework.module.type=HYBRID

# ====================================================================
# WEB CONFIGURATION (si usas web-core)
# ====================================================================

# URL base de la aplicación web
# OBLIGATORIO si usas web-core
#web.base.url=https://your-app.com

# Navegador a utilizar: chrome, firefox, edge, safari
# OPCIONAL - Default: chrome
#web.browser=chrome

# Modo headless (sin interfaz gráfica): true, false
# OPCIONAL - Default: false
#web.headless=false

# --- Timeouts (en segundos) ---

# Timeout implícito para localización de elementos
# OPCIONAL - Default: 10
#web.timeout.implicit=10

# Timeout explícito por defecto
# OPCIONAL - Default: 15
#web.timeout.explicit=15

# Timeout de carga de página
# OPCIONAL - Default: 30
#web.timeout.pageLoad=30

# --- Screenshots ---

# Habilitar capturas de pantalla: true, false
# OPCIONAL - Default: true
#web.screenshots.enabled=true

# Directorio para guardar screenshots
# OPCIONAL - Default: target/screenshots
#web.screenshots.dir=target/screenshots

# Capturar screenshot en cada paso: true, false
# OPCIONAL - Default: false
#web.screenshots.onEveryStep=false

# --- Selenium Grid (solo si usas grid) ---

# Modo de ejecución: local, grid
# OPCIONAL - Default: local
#web.execution.mode=local

# URL del Selenium Grid Hub (solo para modo grid)
# OPCIONAL - Solo necesario si execution.mode=grid
#web.grid.hub.url=http://localhost:4444/wd/hub

# ====================================================================
# API CONFIGURATION (si usas api-core)
# ====================================================================

# URL base del API
# OBLIGATORIO si usas api-core
#api.base.url=https://api.your-app.com/v1

# --- Timeouts (en milisegundos) ---

# Timeout de conexión HTTP
# OPCIONAL - Default: 5000 (5 segundos)
#api.timeout.connection=5000

# Timeout de lectura de respuesta HTTP
# OPCIONAL - Default: 30000 (30 segundos)
#api.timeout.request=30000

# --- SSL/TLS ---

# Verificar certificados SSL: true, false
# OPCIONAL - Default: false (deshabilitado para testing)
# ⚠️ En PROD siempre debe ser true
#api.ssl.verify=false

# --- Retry Policy ---

# Número máximo de reintentos
# OPCIONAL - Default: 0 (sin reintentos)
#api.retry.max=3

# Delay entre reintentos (milisegundos)
# OPCIONAL - Default: 1000
#api.retry.delay=1000

# --- Authentication (según tu API) ---

# Tipo de autenticación: none, basic, bearer, oauth, apikey
# OPCIONAL - Configura según necesidades de tu API
#api.auth.type=bearer

# Token de autenticación (puede usar variables de entorno)
# OPCIONAL - Usar ${API_TOKEN} para referencias desde .env.local
#api.auth.token=${API_TOKEN}

# API Key (si tu API la usa)
# OPCIONAL
#api.auth.apiKey=${API_KEY}

# --- Headers Predeterminados ---

# Content-Type predeterminado
# OPCIONAL - Default: application/json
#api.headers.contentType=application/json

# Accept predeterminado
# OPCIONAL - Default: application/json
#api.headers.accept=application/json

# ====================================================================
# MOBILE CONFIGURATION (si usas mobile-core)
# ====================================================================

# Plataforma: android, ios
# OBLIGATORIO si usas mobile-core
#mobile.platform=android

# --- Device Configuration ---

# Nombre del dispositivo o emulador
# OBLIGATORIO - Ejemplo: "Pixel 5 API 30", "iPhone 13"
#mobile.device.name=Pixel 5 API 30

# UDID del dispositivo (solo para dispositivos físicos)
# OPCIONAL
#mobile.device.udid=

# Platform version
# OPCIONAL - Ejemplo: "12.0", "15.0"
#mobile.platform.version=12.0

# --- Application Configuration ---

# Ruta al APK/IPA de la aplicación
# OBLIGATORIO - Puede ser relativa o absoluta
#mobile.app.path=/path/to/your/app.apk

# Package de la aplicación (Android)
# OPCIONAL - Se auto-detecta desde el APK
#mobile.app.package=com.yourcompany.app

# Activity principal (Android)
# OPCIONAL - Se auto-detecta desde el APK
#mobile.app.activity=.MainActivity

# Bundle ID (iOS)
# OPCIONAL - Se auto-detecta desde el IPA
#mobile.app.bundleId=com.yourcompany.app

# --- Appium Server ---

# URL del servidor Appium
# OPCIONAL - Default: http://localhost:4723/wd/hub
#mobile.appium.url=http://localhost:4723/wd/hub

# --- Timeouts (en segundos) ---

# Timeout implícito para localización de elementos
# OPCIONAL - Default: 10
#mobile.timeout.implicit=10

# Timeout explícito por defecto
# OPCIONAL - Default: 15
#mobile.timeout.explicit=15

# Timeout de inicio de aplicación
# OPCIONAL - Default: 60
#mobile.timeout.appStart=60

# --- Capabilities Adicionales ---

# Modo de automatización (Android)
# OPCIONAL - Default: UiAutomator2
#mobile.automation.name=UiAutomator2

# Reiniciar app entre tests: true, false
# OPCIONAL - Default: false
#mobile.app.reset=false

# Instalación completa: true, false
# OPCIONAL - Default: false
#mobile.app.fullReset=false

# --- Screenshots ---

# Habilitar capturas de pantalla: true, false
# OPCIONAL - Default: true
#mobile.screenshots.enabled=true

# Directorio para guardar screenshots
# OPCIONAL - Default: target/screenshots
#mobile.screenshots.dir=target/screenshots

# ====================================================================
# DATABASE CONFIGURATION (si usas TestDataFinder)
# ====================================================================

# URL de conexión a base de datos
# OBLIGATORIO si usas test data finder
# Ejemplos:
#   Oracle:     jdbc:oracle:thin:@//host:port/service
#   PostgreSQL: jdbc:postgresql://host:port/database
#   MySQL:      jdbc:mysql://host:port/database
#   SQL Server: jdbc:sqlserver://host:port;databaseName=database
#db.url=jdbc:oracle:thin:@//localhost:1521/TESTDB

# Usuario de base de datos (usa variables de entorno)
# OBLIGATORIO si usas test data finder
# ⚠️ USAR VARIABLE DE ENTORNO: ${DB_USER_QA}
#db.username=${DB_USER_QA}

# Password de base de datos (usa variables de entorno)
# OBLIGATORIO si usas test data finder
# ⚠️ NUNCA hardcodear passwords - USAR VARIABLE: ${DB_PASS_QA}
#db.password=${DB_PASS_QA}

# Driver JDBC
# OPCIONAL - Default depende del tipo de BD
# Valores comunes:
#   Oracle:     oracle.jdbc.OracleDriver
#   PostgreSQL: org.postgresql.Driver
#   MySQL:      com.mysql.cj.jdbc.Driver
#   SQL Server: com.microsoft.sqlserver.jdbc.SQLServerDriver
#db.driver=oracle.jdbc.OracleDriver

# --- Connection Pool Configuration ---

# Tamaño mínimo del pool de conexiones
# OPCIONAL - Default: 2
#db.pool.size.min=2

# Tamaño máximo del pool de conexiones
# OPCIONAL - Default: 10
#db.pool.size.max=10

# Timeout de conexión (milisegundos)
# OPCIONAL - Default: 30000
#db.pool.connectionTimeout=30000

# Tiempo máximo de vida de una conexión (milisegundos)
# OPCIONAL - Default: 1800000 (30 minutos)
#db.pool.maxLifetime=1800000

# --- Test Data ---

# Archivo YAML con queries de test data
# OPCIONAL - Default: test-data-queries.yml
#testdata.queries.file=test-data-queries.yml

# ====================================================================
# REPORTING
# ====================================================================

# Habilitar generación de reportes: true, false
# OPCIONAL - Default: true
report.enabled=true

# Directorio de salida de reportes
# OPCIONAL - Default: target/cucumber-reports
report.output.dir=target/cucumber-reports

# Formato de reporte: html, json, xml
# OPCIONAL - Default: html
#report.format=html

# ====================================================================
# LOGGING
# ====================================================================

# Nivel de logging: trace, debug, info, warn, error
# OPCIONAL - Default: info
#log.level=info

# Loggear request bodies (API): true, false
# OPCIONAL - Default: false (puede exponer datos sensibles)
#log.request.body=false

# Loggear response bodies (API): true, false
# OPCIONAL - Default: false (puede generar logs muy largos)
#log.response.body=false

# ====================================================================
# PARALLEL EXECUTION (si usas ejecución paralela)
# ====================================================================

# Habilitar ejecución paralela: true, false
# OPCIONAL - Default: false
#parallel.enabled=false

# Número de threads paralelos
# OPCIONAL - Default: 4
#parallel.threads=4

# ====================================================================
# NOTAS IMPORTANTES
# ====================================================================
#
# 1. OBLIGATORIO vs OPCIONAL:
#    - Propiedades OBLIGATORIO deben configurarse para usar esa capa
#    - Propiedades OPCIONAL tienen valores por defecto
#
# 2. VARIABLES DE ENTORNO:
#    - Usa sintaxis: ${VARIABLE_NAME}
#    - Ejemplos: ${DB_USER_QA}, ${API_TOKEN}, ${WEB_BASE_URL}
#    - Define las variables en .env.local (NO commitear)
#
# 3. AMBIENTES:
#    - Crea un archivo por ambiente (config-dev, config-qa, config-uat)
#    - Selecciona ambiente: ./gradlew test -Denv=qa
#
# 4. OVERRIDES POR LÍNEA DE COMANDO:
#    - Puedes sobrescribir cualquier propiedad:
#      ./gradlew test -Dweb.browser=firefox -Dweb.headless=true
#
# 5. SEGURIDAD:
#    - ⚠️ NUNCA commitear passwords, tokens, o credenciales
#    - Usa siempre variables de entorno para valores sensibles
#    - El archivo .env.local debe estar en .gitignore
#
# 6. CONFIGURAR SOLO LO QUE USES:
#    - Si tu módulo es solo API → descomenta solo sección API
#    - Si es híbrido (WEB+API) → descomenta ambas secciones
#    - Si no usas database → deja esa sección comentada
#
# 7. DOCUMENTACIÓN:
#    - Ver: doc/GUIA-CONFIGURACION-MODULOS.md
#    - Ver: common/TAGS-GUIDE.md
#
# ====================================================================

