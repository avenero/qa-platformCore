# Plantilla de variables de entorno para desarrollo local
# Copia este archivo a .env.local y configura valores reales
# ⚠️ NO COMMITEAR .env.local - está en .gitignore

# ====================================================================
# AMBIENTE
# ====================================================================
TEST_ENV=dev

# ====================================================================
# WEB (si usas web-core)
# ====================================================================
WEB_BASE_URL=https://dev.your-app.com

# ====================================================================
# API (si usas api-core)
# ====================================================================
API_BASE_URL=https://api-dev.your-app.com/v1
API_TOKEN=your_development_token_here

# ====================================================================
# MOBILE (si usas mobile-core)
# ====================================================================
APP_PATH=/path/to/your/app-dev.apk

# ====================================================================
# BASE DE DATOS (si usas TestDataFinder)
# ====================================================================
DB_URL=jdbc:postgresql://localhost:5432/testdb
DB_USER_DEV=test_user
DB_PASS_DEV=test_password

# ====================================================================
# INSTRUCCIONES DE USO:
# ====================================================================
# 1. Copiar este archivo:
#    cp .env.example .env.local
#
# 2. Editar .env.local con valores reales
#
# 3. Cargar variables antes de ejecutar tests:
#    source .env.local
#    ./gradlew test
#
# 4. O usar en tu IDE configurando las variables de entorno
#
# 5. En CI/CD, configurar variables en el servidor
#    (Jenkins, GitLab CI, GitHub Actions, etc.)
# ====================================================================

