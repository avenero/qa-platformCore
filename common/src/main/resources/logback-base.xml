<?xml version="1.0" encoding="UTF-8"?>
<!--
    PLANTILLA BASE DE LOGBACK PARA FRAMEWORKS DE SCOTIA QA

    Este archivo es una plantilla base que puede ser copiada y personalizada
    para cada framework específico (API, Web, Mobile).

    INSTRUCCIONES:
    1. Copiar este archivo a cada módulo de framework como logback.xml
    2. Personalizar las variables según el framework específico
    3. Ajustar appenders y loggers según las necesidades

    ESTRUCTURA DE LOGS RECOMENDADA:
    logs/
    ├── api/
    │   ├── api-tests.log
    │   ├── api-evidences.log
    │   └── api-errors.log
    ├── web/
    │   ├── web-tests.log
    │   ├── web-evidences.log
    │   └── web-errors.log
    └── mobile/
        ├── mobile-tests.log
        ├── mobile-evidences.log
        └── mobile-errors.log
-->
<configuration>

    <!-- Suprimir mensajes internos de logback/SLF4J -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- VARIABLES - PERSONALIZAR SEGÚN FRAMEWORK -->
    <property name="LOG_HOME" value="logs/{FRAMEWORK_NAME_LOWER}" />
    <property name="FRAMEWORK_NAME" value="{FRAMEWORK_NAME_UPPER}" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [${FRAMEWORK_NAME}][%X{feature}][%X{scenario}] %logger{36} - %msg%n" />
    <!-- Pattern con colores ANSI para consola -->
    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} %highlight(%-5level) [${FRAMEWORK_NAME}][%X{scenario}] %cyan(%logger{20}) - %msg%n" />

    <!-- Appender para consola con colores -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Appender para archivo general -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/{framework}-tests.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/{framework}-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Appender específico para evidencias -->
    <appender name="EVIDENCE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/{framework}-evidences.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [{FRAMEWORK_NAME}-EVIDENCE] [%X{feature}][%X{scenario}] - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/{framework}-evidences.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Appender específico para errores -->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/{framework}-errors.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/{framework}-errors.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- LOGGERS COMUNES PARA TODOS LOS FRAMEWORKS -->

    <!-- Logger específico para componentes comunes -->
    <logger name="com.scotia.qa.common" level="INFO">
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger específico para evidencias -->
    <logger name="com.scotia.qa.common.logging.EvidenceManager" level="INFO">
        <appender-ref ref="EVIDENCE" />
    </logger>

    <!-- Logger específico para hooks de Cucumber -->
    <logger name="com.scotia.qa.common.cucumber" level="INFO">
        <appender-ref ref="FILE" />
    </logger>

    <!-- AGREGAR LOGGERS ESPECÍFICOS DEL FRAMEWORK AQUÍ -->
    <!-- Ejemplos:
    Para API:
    <logger name="io.restassured" level="INFO">
        <appender-ref ref="EVIDENCE" />
    </logger>

    Para Web:
    <logger name="org.seleniumhq.selenium" level="INFO">
        <appender-ref ref="EVIDENCE" />
    </logger>

    Para Mobile:
    <logger name="io.appium" level="INFO">
        <appender-ref ref="EVIDENCE" />
    </logger>
    -->

    <!-- Loggers de terceros con nivel más alto -->
    <logger name="org.springframework" level="WARN" />
    <logger name="io.cucumber" level="INFO" />
    <logger name="org.apache.commons" level="WARN" />
    <logger name="org.apache.http" level="WARN" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR" />
    </root>

</configuration>

